# =================================================================
# ENV PROD RUNTIME - Reference du .env distant sur VPS
# Ne pas committer de vraies valeurs. Genere une fois par scripts/deploy-to-vps.sh
# Mapping : .env.deploy DB_NAME/DB_USER/DB_PASSWORD -> POSTGRES_DB/POSTGRES_USER/POSTGRES_PASSWORD
#           + DATABASE_URL=postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB?sslmode=disable
#           NEXT_PUBLIC_APP_URL -> BETTER_AUTH_URL (fallback auto)
# =================================================================

# --- DB (construite, ne pas editer a la main en prod) ---
DATABASE_URL="postgresql://user:password@postgres:5432/attestation_fsa?sslmode=disable"
POSTGRES_USER="attestation_fsa_user"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="attestation_fsa"

# --- AUTH ---
AUTH_SECRET="genere-via-openssl-rand-base64-32"
BETTER_AUTH_SECRET="genere-via-openssl-rand-base64-32"
BETTER_AUTH_URL="https://votre-domaine.com"
NODE_ENV="production"
PORT="3000"

# --- APP URL (bakee au build via build.args, cf compose.prod.yml) ---
NEXT_PUBLIC_APP_URL="https://votre-domaine.com"

# --- REDIS (Upstash uniquement, KV_* legacy supprime) ---
UPSTASH_REDIS_REST_URL="https://your-project.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"

# --- EMAIL ---
RESEND_API_KEY="re_xxx"
RESEND_DOMAIN="votre-domaine.com"
EMAIL_FROM="FSA <noreply@votre-domaine.com>"

# --- PUSHER (PUSHER_API_KEY legacy supprime, inutile dans le code) ---
PUSHER_APP_ID="xxx"
PUSHER_KEY="xxx"
PUSHER_SECRET="xxx"
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY="xxx"
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# --- BOT ---
BOTID_SECRET="votre_secret_botid_ici"

# --- TRAEFIK (VPS, reseau proxy externe) ---
# Reseau cree sur VPS : docker network create traefik-public
# TRAEFIK_HOST = domaine sans https (ex: attestations.fermestandre.com)
TRAEFIK_NETWORK="traefik-public"
TRAEFIK_HOST="votre-domaine.com"
TRAEFIK_ENTRYPOINT="websecure"
TRAEFIK_CERTRESOLVER="letsencrypt"
ADMIN_USER_IDS=uuid-admin-1,uuid-admin-2
