{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "ci": {
      "description": "Agent CI issue→PR : résout une issue GitHub et produit un diff vérifié par pnpm verify. Utilisé par le workflow agent-issue-to-pr. Ne pousse jamais : le workflow committe après le gate.",
      "mode": "all",
      "tools": {
        "read": true,
        "edit": true,
        "write": true,
        "bash": true,
        "glob": true,
        "grep": true,
        "list": true,
        "todowrite": true,
        "webfetch": true,
        "websearch": true,
        "skill": true,
        "task": false
      },
      "permission": {
        "edit": {
          "*": "allow",
          ".env*": "deny",
          "**/*.pem": "deny",
          "**/*.p12": "deny",
          "**/*.pfx": "deny",
          "**/*.key": "deny",
          "prisma/migrations/**": "deny",
          ".github/workflows/**": "deny"
        },
        "bash": {
          "*": "allow",
          "git push*": "deny",
          "git reset --hard*": "deny",
          "git clean*": "deny",
          "git branch -D*": "deny",
          "git checkout .*": "deny",
          "git commit*": "deny",
          "rm -rf /": "deny",
          "rm -rf ~*": "deny",
          "rm -rf .git*": "deny",
          "gh pr create*": "deny",
          "gh issue close*": "deny",
          "gh repo delete*": "deny"
        }
      }
    }
  }
}