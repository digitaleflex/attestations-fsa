# =================================================================
# ENVIRONMENT VARIABLES - VPS Production
# =================================================================
# Copy this file to .env on your VPS and fill in the values
# cp .env.vps.example .env
# =================================================================

# =================================================================
# DATABASE (PostgreSQL self-hosted)
# =================================================================
# Format: postgresql://USER:PASSWORD@localhost:5432/DB_NAME?sslmode=disable
DATABASE_URL="postgresql://attestation_fsa_user:YOUR_DB_PASSWORD@localhost:5432/attestation_fsa?sslmode=disable"

# =================================================================
# AUTHENTICATION (Better Auth)
# =================================================================
# Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_openssl_rand_base64_32"
BETTER_AUTH_SECRET="CHANGE_ME_openssl_rand_base64_32"
BETTER_AUTH_URL="https://your-domain.com"

# =================================================================
# APPLICATION
# =================================================================
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NODE_ENV=production

# =================================================================
# REDIS (Upstash - Required for Rate Limiting)
# =================================================================
# Create a free account at https://upstash.com
UPSTASH_REDIS_REST_URL="https://your-project.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_token"

# =================================================================
# EMAIL (Resend)
# =================================================================
# Create an account at https://resend.com
RESEND_API_KEY="re_your_api_key"
RESEND_DOMAIN="your-domain.com"
EMAIL_FROM="Ferme St André <noreply@your-domain.com>"

# =================================================================
# PUSHER (Real-time notifications)
# =================================================================
# Create an app at https://pusher.com
PUSHER_APP_ID="your_app_id"
PUSHER_KEY="your_key"
PUSHER_SECRET="your_secret"
PUSHER_CLUSTER="eu"
NEXT_PUBLIC_PUSHER_KEY="your_key"
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# =================================================================
# BOTID (Bot Detection - Vercel Kasada)
# =================================================================
# Create at https://dashboard.vercel.com (Kasada integration)
BOTID_SECRET="your_botid_secret"

# =================================================================
# PORT (Optional, default: 3000)
# =================================================================
PORT=3000
