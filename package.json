{
  "name": "attestation-fsa",
  "version": "3.0.1",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts",
    "data:export-reference": "ts-node --project tsconfig.seed.json scripts/export-reference.ts",
    "data:integrity": "ts-node --project tsconfig.seed.json scripts/check-data-integrity.ts --dry-run",
    "data:migration-plan": "ts-node --project tsconfig.seed.json scripts/classify-attestation-migration.ts --dry-run",
    "backup:manifest": "ts-node --project tsconfig.seed.json scripts/backup-manifest.ts",
    "backup:verify-restore": "ts-node --project tsconfig.seed.json scripts/verify-backup-restore.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "test:coverage": "vitest run --coverage",
    "test:r2-scripts": "bash scripts/tests/test-r2-scripts.sh",
    "drill:restore": "bash scripts/restore-drill.sh",
    "check:migrations": "node scripts/check-destructive-migrations.mjs",
    "verify": "tsc --noEmit && eslint . && vitest run && node scripts/check-destructive-migrations.mjs",
    "e2e:db:up": "docker compose -f compose.local.yml up -d postgres-e2e",
    "e2e:db:down": "docker compose -f compose.local.yml stop postgres-e2e",
    "e2e:db:migrate": "node scripts/e2e-prisma.mjs migrate deploy",
    "e2e:seed": "node scripts/e2e-prisma.mjs db seed",
    "e2e:setup": "pnpm e2e:db:up && pnpm e2e:db:migrate && pnpm e2e:seed"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@hookform/resolvers": "^5.9.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "14.2.0",
    "ioredis": "^6.0.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^1.57.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.2",
    "nextjs-toploader": "^3.9.17",
    "pg": "^8.23.1",
    "pusher": "^5.3.4",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-qr-code": "^2.2.0",
    "resend": "^6.34.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=4.0.6",
      "undici": "^7.29.0",
      "browserslist": ">=4.28.7",
      "deepmerge-ts": ">=8.0.0",
      "uuid": "^11.1.1",
      "fflate": ">=0.8.3",
      "baseline-browser-mapping": ">=2.11.0",
      "@babel/core": "^7.29.6",
      "fast-uri": "^3.1.6",
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9",
      "js-yaml": "^4.3.2",
      "nanoid@3": "^3.3.18",
      "postcss": "^8.5.23",
      "ws": "^8.21.0",
      "qs": "^6.16.0",
      "@humanfs/node": "^0.16.8",
      "@vitest/mocker": "^4.1.11"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webpack": "^5.28.5",
    "@vitest/coverage-v8": "^4.1.12",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "postcss": "^8.5.30",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.1.12",
    "webpack": "^5.112.0"
  },
  "prisma": {
    "seed": "ts-node --project tsconfig.seed.json prisma/seed.ts"
  },
  "packageManager": "pnpm@9.15.4"
}
