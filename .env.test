# =================================================================
# ENVIRONNEMENT DE TEST — VALEURS FACTICES UNIQUEMENT (issue #11)
# Chargé par `tests/setup.ts`. Ne jamais y mettre de vrais secrets.
# Les variables déjà définies (CI, shell) restent prioritaires.
# =================================================================

NODE_ENV="test"

# Base factice : les tests mockent `@/lib/prisma`, aucune connexion réelle.
DATABASE_URL="postgresql://test:test@localhost:5433/attestations_fsa_test"

# Secrets factices (min 32 caractères, inutilisables hors tests).
BETTER_AUTH_SECRET="test-only-secret-min-32-chars-0123456789abcdef"
AUTH_SECRET="test-only-secret-min-32-chars-0123456789abcdef"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
ADMIN_USER_IDS="test-admin-id-1,test-admin-id-2"

# Redis VOLONTAIREMENT ABSENT : définir ces variables (même factices) ferait
# passer `isRedisReady()` à vrai et casserait les tests du fallback mémoire.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# E-mail factice : aucun envoi réel en test (service mocké).
# RESEND_API_KEY volontairement ABSENTE : les tests `tests/lib/email*.test.ts`
# supposent son absence ambiante (scénarios « non configuré »).
# RESEND_API_KEY="re_test_only_key"
EMAIL_FROM="FSA Test <test@example.com>"

APP_TIMEZONE="Africa/Porto-Novo"
# CRON_SECRET volontairement ABSENT : `internal-open-exams` et `retention-purge`
# supposent son absence ambiante (401 sans secret).
# CRON_SECRET="test-only-cron-secret-min-16-chars"
# CERT_SEAL_SECRET volontairement ABSENT : les tests de scellement supposent
# son absence ambiante (scénarios 503 « clé indisponible »).
# CERT_SEAL_SECRET="test-only-seal-secret"
STORAGE_DRIVER="local"
