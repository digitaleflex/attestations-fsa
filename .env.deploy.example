# =================================================================
# DEPLOY CONFIGURATION
# Copiez ce fichier vers .env.deploy et remplissez les valeurs
# cp .env.deploy.example .env.deploy
# =================================================================

# ── VPS Connection ────────────────────────────────────────────────
VPS_HOST=192.168.1.100
VPS_USER=root
VPS_PORT=22
VPS_APP_DIR=/home/audest/attestation-fsa

# ── Database ──────────────────────────────────────────────────────
DB_NAME=attestation_fsa
DB_USER=attestation_fsa_user
DB_PASSWORD=attestation_fsa_password

# ── Docker (local dev) ───────────────────────────────────────────
DOCKER_CONTAINER=attestations-fsa-postgres
DOCKER_PORT=5433

# ── Application (copied to VPS .env) ─────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ── Redis (Upstash) ──────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=
RESEND_DOMAIN=
EMAIL_FROM="FSA <noreply@fermestandre.com>"

# ── Pusher (Real-time) ──────────────────────────────────────────
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# ── Bot Detection ────────────────────────────────────────────────
BOTID_SECRET=
ADMIN_USER_IDS=uuid-admin-1,uuid-admin-2
