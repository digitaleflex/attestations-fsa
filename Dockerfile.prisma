FROM node:22-alpine

WORKDIR /app

# openssl requis par le CLI Prisma
RUN apk add --no-cache openssl

# pnpm épinglé (aligné avec packageManager / Dockerfile principal)
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Schéma + migrations avant l'install (postinstall: prisma generate)
COPY prisma ./prisma/
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

ENTRYPOINT ["pnpm", "exec", "prisma"]
CMD ["migrate", "deploy"]
