# =================================================================
# Environment variables for local Docker testing
# Copy to .env.docker or use directly with compose.local.yml
# =================================================================

POSTGRES_USER=attestation_fsa_user
POSTGRES_PASSWORD=attestation_fsa_password
POSTGRES_DB=attestation_fsa
POSTGRES_PORT=5432

DATABASE_URL=postgresql://attestation_fsa_user:attestation_fsa_password@localhost:5432/attestation_fsa?sslmode=disable

# Minimal auth secret for local testing
AUTH_SECRET=local_development_secret_replace_in_production
BETTER_AUTH_SECRET=local_development_secret_replace_in_production
BETTER_AUTH_URL=http://localhost:3000

NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
