# =================================================================
# ENVIRONMENT VARIABLES - EXAMPLE
# Copiez ce fichier vers .env.local et remplissez les valeurs
# =================================================================

# =================================================================
# DATABASE
# =================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/attestations_fsa"

# =================================================================
# AUTHENTICATION (Better Auth)
# =================================================================
# Générer avec: openssl rand -base64 32
AUTH_SECRET="votre-secret-tres-long-et-aleatoire-min-32-caracteres"

# =================================================================
# REDIS (Upstash - Requis pour Rate Limiting)
# =================================================================
# Créer un compte gratuit sur https://upstash.com
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# =================================================================
# EMAIL (Resend)
# =================================================================
# Créer un compte sur https://resend.com
RESEND_API_KEY="re_xxx"
EMAIL_FROM="Ferme St André <noreply@votre-domaine.com>"

# =================================================================
# APPLICATION
# =================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# En production : NEXT_PUBLIC_APP_URL="https://votre-domaine.com"

# Origines supplémentaires autorisées par Better Auth (séparées par virgule)
# En production l'allowlist est EXACTE : ni joker (*.vercel.app, localhost) ni
# adresse IP. Voir docs/security/01-mesures-securite.md.
# BETTER_AUTH_TRUSTED_ORIGINS="https://verifier.votre-domaine.com,https://autre-domaine.com"
# Échappatoire explicite (déconseillée, à n'utiliser que le temps d'une migration) :
# BETTER_AUTH_TRUST_ORIGINS_ALLOW_WILDCARDS="true"

# Hôtes distants autorisés par le proxy d'images next/image (#284).
# HTTPS uniquement, jokers et IP littérales rejetés. Si la liste est vide après
# filtrage, le proxy est fermé (fail closed).
# S3_PUBLIC_BASE_URL et NEXT_PUBLIC_APP_URL sont déjà pris en compte.
# NEXT_IMAGE_REMOTE_HOSTS="cdn.votre-domaine.com,media.votre-domaine.com"
# En développement uniquement, pour un stockage HTTP local (MinIO) :
# NEXT_IMAGE_REMOTE_HOSTS_INSECURE="minio,localhost"

# =================================================================
# FUSEAU HORAIRE APPLICATIF (planning des examens)
# =================================================================
# Référence unique des dates calendaires : le jour d'ouverture d'un examen
# ("jour J") commence à 00:00:00 dans ce fuseau. Toutes les dates sont stockées
# en UTC ; ce fuseau ne sert qu'à interpréter la journée. Les routes et les
# tests n'utilisent jamais le fuseau de la machine hôte ni celui du navigateur.
# REQUIS en production : sans elle, la valeur par défaut ci-dessous s'applique et
# aucun code ne peut arbitrer un autre fuseau (produit : Africa/Porto-Novo).
# DÉclaré dans compose.prod.yml (`fsa-app`) : l'y laisser vide casse ici.
APP_TIMEZONE="Africa/Porto-Novo"

# =================================================================
# NODE ENVIRONMENT
# =================================================================
NODE_ENV="development"
# En production : NODE_ENV="production"

# envsitter: IDs admin Better Auth (séparés par virgule) — remplace les UUID codés en dur
ADMIN_USER_IDS=uuid-admin-1,uuid-admin-2
BETTER_AUTH_SECRET=votre-secret-better-auth-min-32-caracteres
PUSHER_KEY=xxx
PUSHER_SECRET=xxx
PUSHER_CLUSTER=eu
NEXT_PUBLIC_PUSHER_KEY=xxx
NEXT_PUBLIC_PUSHER_CLUSTER=eu
NEW_ADMIN_PASSWORD=mot-de-passe-admin-temporaire
BETTER_AUTH_URL=http://localhost:3000
PUSHER_APP_ID=xxx
RESEND_DOMAIN=hashcode.cloud

# =================================================================
# STOCKAGE OBJET — uploads CV / images (requis en production)
# =================================================================
# Driver : auto (défaut) | s3 | local
#   auto => S3 si S3_BUCKET est défini, sinon fichiers locaux (dev uniquement).
#   En production, le driver local est refusé sauf opt-in volume persistant.
STORAGE_DRIVER=auto

# S3-compatible : Cloudflare R2, AWS S3, MinIO, Scaleway…
S3_BUCKET=attestations-fsa
S3_REGION=auto
# R2 : https://<account-id>.r2.cloudflarestorage.com · MinIO : http://minio:9000
# S3_ENDPOINT=https://xxx.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=xxx
# MinIO / S3-compatibles nécessitant le bucket dans le path
# S3_FORCE_PATH_STYLE=true
# Durée de vie des URL signées en secondes (défaut : 604800 = 7 jours)
STORAGE_SIGNED_URL_TTL_SECONDS=604800
# Bucket public-read uniquement (objets non nominatifs) — jamais CV/scans
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# Fallback fichier local (dev, ou volume persistant via opt-in explicite)
# STORAGE_LOCAL_DIR=/var/lib/fsa/uploads
# STORAGE_ALLOW_LOCAL_IN_PRODUCTION=true

# =================================================================
# SAUVEGARDES R2 — monitoring (#295)
# =================================================================
# Variables lues par scripts/r2-backup.sh, scripts/r2-restore.sh,
# scripts/check-r2-versioning.sh, scripts/check-r2-backup-freshness.sh et
# scripts/check-r2-alerts.sh (et par .github/workflows/backup-monitor.yml
# via les secrets GitHub de mêmes noms — jamais committer de valeurs réelles).
# R2_BUCKET="attestations-fsa"
# R2_ACCOUNT_ID="xxx"
# R2_ENDPOINT auto-dérivé si absent : https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT="https://xxx.r2.cloudflarestorage.com"
# R2_PROFILE="default"
# Répertoire local des exports (doit matcher BACKUP_DIR du contrôle fraîcheur) :
# R2_BACKUP_DIR="/home/audest/backups/attestation-fsa"
# Préfixe d'objets dans le bucket (vide = tout le bucket) :
# R2_PREFIX=""
# Restauration : répertoire créé par r2-backup.sh (contient manifest.json) :
# R2_SOURCE_DIR="/home/audest/backups/attestation-fsa/<date>"
# Fraîcheur : âge max d'un export `r2-export-*.manifest.json` avant alerte :
# MAX_AGE_HOURS=30
# Webhook d'alerte optionnel (POST best effort de check-r2-alerts.sh) :
# ALERT_WEBHOOK=""

# =================================================================
# SCELLEMENT DES CERTIFICATS (#155) — valeur probante
# =================================================================
# Clé HMAC-SHA256 utilisée pour sceller les attestations (min 16 caractères).
# Générer avec: openssl rand -base64 48
# Si absente, le scellement est désactivé (dégradé, non bloquant).
CERT_SEAL_SECRET=""

# =================================================================
# PDF OFFICIEL SERVEUR (#258) — OBLIGATOIRE en production
# =================================================================
# Module Node exportant :
#   generateCanonicalAttestationPdf(input) => Promise<Uint8Array | Buffer>
# `input` reçoit le snapshot du document, le numéro de version du PDF et
# l'URL publique `/verifier?code=…` à encoder dans le QR. Il ne reçoit ni
# session, ni clé de scellement, ni secret.
# Le résultat est stocké sous `attestations/<code>/v<N>.pdf` puis hashé (SHA-256)
# et scellé : le PDF n'est jamais régénéré dans le navigateur.
# Sans cette variable, l'émission d'attestations officielles est BLOQUÉE
# (mieux vaut aucune attestation qu'un document non probant).
# REQUIS en production ET déclaré dans compose.prod.yml (`fsa-app`) : lu au
# runtime par `lib/attestations/pdf.ts`, donc un module présent sur le disque
# mais non déclaré au conteneur reste invisible.
# Générateur PDF officiel pour les attestations (#307)
# Module chargé dynamiquement — doit exporter generateCanonicalAttestationPdf(input).
ATTESTATION_PDF_GENERATOR_MODULE="./lib/attestations/pdf-generator/index.ts"

# =================================================================
# BACKUP (scripts/vps-pre-deploy-backup.sh) — hors site chiffré
# OBLIGATOIRE en production
# =================================================================
# OBLIGATOIRES en production, et pas seulement recommandées : le script
# REFUSE de s'exécuter (code de sortie non nul, donc déploiement arrêté) dès
# que `NODE_ENV=production` et que l'une des deux est absente. Il refuse
# aussi si les binaires `rclone` ou `age` manquent de l'hôte.
#   BACKUP_REMOTE         destination rclone, ex: "spaces:fsa-backups"
#   BACKUP_AGE_RECIPIENT  clé publique age, ex: "age1..."
# Clé privée age : JAMAIS ici, jamais dans le dépôt, jamais dans le bucket
# (elle sert à déchiffrer ; escrow à définir, cf. procedures.md § 5.5).
#
# Ces deux variables sont lues par le script sur l'HÔTE (cron + CI en SSH),
# pas par un conteneur : BACKUP_ENV_FILE
# (~/.config/attestations-fsa/backup.env, hors dépôt, chmod 600) est la source
# prévue, et il est volontairement absent de compose.prod.yml.
# ⚠️ Y ajouter `NODE_ENV=production` rend le déploiement CI fail-closed sans
# toucher au workflow ; y `# BACKUP_AGE_RECIPIENT` non plus = upload EN CLAIR.
# BACKUP_REMOTE="spaces:fsa-backups"
# BACKUP_AGE_RECIPIENT="age1..."

# =================================================================
# CRON — OUVERTURE DES EXAMENS PLANIFIÉS
# =================================================================
# Secret partagé entre l'application et le cron qui appelle
# `POST /api/internal/exams/open` (Authorization: Bearer $CRON_SECRET).
# Sans ce secret, la route répond 401 et n'ouvre AUCUN examen.
# OBLIGATOIRE en production (déclaré dans compose.prod.yml, pour `fsa-app` ET
# pour le service `exam-cron` : les deux en ont besoin).
# Minimum 16 caractères ; générer avec : openssl rand -base64 48
CRON_SECRET=""
# Période du cron, en secondes (300 = 5 minutes).
# CRON_INTERVAL_SECONDS=300
# Auteur des entrées d'audit créées par le cron (ID d'un utilisateur déjà
# présent en base). Vide = repli sur le premier compte admin.
# CRON_AUDIT_USER_ID=""
