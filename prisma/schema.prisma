generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  scope                 String?
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  accountId             String    @default("")
  createdAt             DateTime  @default(now())
  idToken               String?
  password              String?
  providerId            String    @default("")
  refreshToken          String?
  refreshTokenExpiresAt DateTime?
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  ipAddress String?
  token     String   @unique
  updatedAt DateTime @updatedAt
  userAgent String?
  impersonatedBy String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@index([identifier, expiresAt])
}

model User {
  id                    String              @id @default(uuid())
  name                  String?
  email                 String?             @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  role                  String              @default("user")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  // Admin Plugin Fields
  banned                Boolean?
  banReason             String?
  banExpires            DateTime?
  // Two-Factor Plugin Fields (better-auth twoFactor)
  twoFactorEnabled      Boolean             @default(false)
  
  address               String?
  birthDate             DateTime?
  birthPlace            String?
  phone                 String?
  examId                String?
  examScheduledAt       DateTime?
  formationId           String?
  gender                Gender?
  resetPasswordRequired Boolean             @default(false)
  status                UserStatus          @default(ACTIVE)
  accounts              Account[]
  attestations          Attestation[]
  auditLogs             AuditLog[]
  correctionRequests    CorrectionRequest[]
  examSessions          ExamSession[]
  internships           InternshipRequest[]
  notifications         Notification[]
  reclamations          Reclamation[]
  sessions              Session[]
  twoFactor             TwoFactor[]
  exam                  Exam?               @relation(fields: [examId], references: [id])
  formation             Formation?          @relation(fields: [formationId], references: [id])

  @@index([role])
  @@index([status])
  @@index([formationId])
}

// better-auth `twoFactor` plugin storage (TOTP secret + backup codes).
// Champs `verified` / `failedVerificationCount` / `lockedUntil` requis par
// better-auth >= 1.7 (verrouillage après trop d'échecs de vérification).
model TwoFactor {
  id                      String    @id @default(cuid())
  secret                  String
  backupCodes             String
  userId                  String    @unique
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// VerificationToken removed — NextAuth legacy, unused. Better Auth uses `Verification` model.
// Migration required: prisma migrate dev --name remove_legacy_models

model Formation {
  id           String        @id @default(uuid())
  name         String
  category     String
  description  String?
  skills       String[]
  createdAt    DateTime      @default(now())
  attestations Attestation[]
  exams        Exam[]
  users        User[]
}

model Attestation {
  id                        String                @id @default(uuid())
  code                      String                @unique
  issuedAt                  DateTime              @default(now())
  type                      AttestationType       @default(FORMATION)
  fullName                  String
  email                     String?
  birthDate                 DateTime
  birthPlace                String
  formationId               String
  startDate                 DateTime
  endDate                   DateTime
  location                  String
  instructor                String
  issuingCompany            String
  status                    AttestationStatus     @default(PENDING)
  pdfUrl                    String?
  certificationHours        Int?
  certificationMention      CertificationMention?
  certificationObservations String?
  certificationScore        Float?
  gender                    Gender?
  stageHours                Int?
  stageObservations         String?
  stageScore                Float?
  userId                    String?
  sessionId                 String?
  // Scellement HMAC-SHA256 (#155) — valeur probante interne.
  sealHash                  String?
  sealedAt                  DateTime?
  formation                 Formation             @relation(fields: [formationId], references: [id])
  user                      User?                 @relation(fields: [userId], references: [id])
  correctionRequests        CorrectionRequest[]

  @@index([userId])
  @@index([sessionId])
  @@index([status])
  @@index([userId, status])
  @@index([formationId])
  @@index([issuedAt])
}

model Settings {
  id                 String   @id @default(uuid())
  institutionName    String   @default("Ferme Agro-Piscicole Cité St André")
  replyTo            String?
  updatedAt          DateTime @updatedAt
  targetAttestations Int      @default(300)
  targetInscriptions Int      @default(500)
  targetValidations  Int      @default(450)
  institutionLogo    String?
  instructorName     String   @default("Directeur Technique")
  instructorTitle    String   @default("Responsable des Formations")
  location           String   @default("Abomey-Calavi")
  signatureUrl       String?
  supportEmail       String   @default("contact@fermestandre.com")
}

model Report {
  id              String   @id @default(uuid())
  codeAttestation String?
  motif           String
  message         String
  email           String?
  createdAt       DateTime @default(now())
  status          String   @default("NOUVEAU")
}

model Exam {
  id                 String        @id @default(uuid())
  title              String
  description        String?
  status             ExamStatus    @default(DRAFT)
  totalPoints        Int           @default(100)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  formationId        String?
  duration           Int           @default(3600)
  name               String
  part1Enabled       Boolean       @default(true)
  part1Points        Int           @default(20)
  part1Questions     Int           @default(20)
  part2Enabled       Boolean       @default(true)
  part2Points        Int           @default(40)
  part2Questions     Int           @default(5)
  part3Enabled       Boolean       @default(true)
  part3Mode          String        @default("digital")
  part3Points        Int           @default(40)
  part3Subject       String?
  passingScore       Int           @default(65)
  randomizeQuestions Boolean       @default(false)
  showResults        Boolean       @default(false)
  scheduledAt        DateTime?
  session            String?
  formation          Formation?    @relation(fields: [formationId], references: [id])
  type               ExamType      @default(OFFICIAL)
  parts              ExamPart[]
  sessions           ExamSession[]
  users              User[]
}

model ExamPart {
  id        String     @id @default(uuid())
  examId    String
  title     String
  type      String
  duration  Int
  points    Int
  order     Int
  scenario  String?
  exam      Exam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  questions Question[]

  @@index([examId])
  @@index([examId, order])
}

model Question {
  id      String           @id @default(uuid())
  partId  String
  text    String
  type    QuestionType     @default(SINGLE_CHOICE)
  points  Float            @default(1)
  order   Int
  part    ExamPart         @relation(fields: [partId], references: [id], onDelete: Cascade)
  options QuestionOption[]

  @@index([partId])
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  text       String
  isCorrect  Boolean  @default(false)
  feedback   String?
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model ExamSession {
  id          String            @id @default(uuid())
  examId      String
  userId      String
  status      String            @default("PENDING")
  scorePart1      Float @default(0) // raw Part 1 auto-grade (QCM)
  scorePart2      Float? // raw Part 2 admin-grade — null = partie non corrigée
  scorePart3      Float? // raw Part 3 admin-grade — null = partie non corrigée
  score           Float @default(0) // legacy Part 1 score alias — prefer scorePart1
  totalScore      Float @default(0) // somme brute des points (scorePart1+2+3) — pas de division par 5
  internshipScore Float @default(0) // internship component score
  finalScore      Float @default(0) // pourcentage examen 0..100 (totalScore / maxPoints * 100) — #124 : internshipScore est un composant SÉPARÉ (note de stage), il n'entre pas dans finalScore
  gradedBy    String?
  gradedAt    DateTime?
  startedAt   DateTime          @default(now())
  submittedAt DateTime?
  updatedAt   DateTime          @updatedAt
  answers     Json?             @default("{}")
  observations String?          // notes de correction (texte riche)
  reclamations Reclamation[]
  type        ExamType          @default(OFFICIAL)
  exam        Exam              @relation(fields: [examId], references: [id])
  candidate   User              @relation(fields: [userId], references: [id])

  @@unique([userId, examId])
  @@index([status])
  @@index([examId, status])
  @@index([userId, status])
  @@index([submittedAt])
  @@index([gradedAt])
}

model InternshipRequest {
  id         String           @id @default(uuid())
  fullName   String
  email      String
  phone      String
  university String?
  level      String?
  position   String
  cvUrl      String?
  message    String?
  status     InternshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  userId     String?
  user       User?            @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
}

model CorrectionRequest {
  id            String           @id @default(uuid())
  userId        String
  attestationId String?
  field         String
  oldValue      String?
  newValue      String
  reason        String?
  status        CorrectionStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  attestation   Attestation?     @relation(fields: [attestationId], references: [id])
  user          User             @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  resource   String
  resourceId String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  timestamp  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([timestamp])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  link      String?
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Contact {
  id          String   @id @default(uuid())
  name        String
  email       String
  phone       String?
  subject     String?
  message     String
  status      String   @default("UNREAD")
  type        String   @default("CONTACT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Admin model removed — orphan table, no relations. Auth uses User.role = "admin" instead.
// Migration required: prisma migrate dev --name remove_legacy_models

model Reclamation {
  id            String           @id @default(uuid())
  userId        String
  submissionId  String
  subject       String
  message       String
  status        String           @default("PENDING")
  adminReply    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id])
  submission    ExamSession      @relation(fields: [submissionId], references: [id])

  @@index([userId])
  @@index([submissionId])
  @@index([status])
  @@index([status, createdAt])
}


enum AttestationStatus {
  PENDING
  VALIDATED
  REJECTED
  CLAIMED
}

enum AttestationType {
  FORMATION
  STAGE
  CERTIFICATION
}

enum Gender {
  M
  F
}

enum CertificationMention {
  PASSABLE
  ASSEZ_BIEN
  BIEN
  TRES_BIEN
  EXCELLENCE
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum ExamType {
  OFFICIAL
  MOCK
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  OPEN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum InternshipStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
  ARCHIVED
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ATTESTATION_VALIDATED
  ATTESTATION_REJECTED
  EXAM_RESULT_PUBLISHED
  INTERNSHIP_ACCEPTED
  INTERNSHIP_REJECTED
  CORRECTION_APPROVED
  CORRECTION_REJECTED
  SUPPORT_REPLY
  GENERAL
}


