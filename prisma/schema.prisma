generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AttestationStatus {
  PENDING      // Code généré mais pas encore réclamé
  CLAIMED      // Code réclamé par le candidat
  VALIDATED    // Attestation validée (après examen réussi)
  REJECTED     // Attestation refusée (examen échoué)
}

enum AttestationType {
  FORMATION
  STAGE
  CERTIFICATION
}

enum Gender {
  M
  F
}

enum CertificationMention {
  PASSABLE
  ASSEZ_BIEN
  BIEN
  TRES_BIEN
  EXCELLENCE
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  OPEN
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String    @default("")
  providerId            String    @default("")
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Session {
  id           String   @id @default(cuid())
  expiresAt    DateTime
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("USER")

  // Informations pour les attestations
  birthDate     DateTime?
  birthPlace    String?
  phone         String?
  address       String?
  gender        Gender?
  
  // Code d'attestation pour débloquer le compte
  attestationCode String? @unique
  attestationStatus String @default("PENDING") // PENDING, CLAIMED, VALIDATED
  
  // Formation et examen associés
  formationId   String?
  formation     Formation? @relation(fields: [formationId], references: [id])
  examId        String?
  exam          Exam? @relation(fields: [examId], references: [id])
  
  // Dates importantes
  enrolledAt    DateTime?
  examScheduledAt DateTime?

  correctionRequests CorrectionRequest[]
  attestations  Attestation[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  examSessions  ExamSession[]
  internships   InternshipRequest[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Formation {
  id           String      @id @default(uuid())
  name         String
  category     String
  description  String?
  skills       String[]
  createdAt    DateTime    @default(now())
  attestations Attestation[]
  exams        Exam[]
  users        User[]
}

model Attestation {
  id             String            @id @default(uuid())
  code           String            @unique
  issuedAt       DateTime          @default(now())
  type           AttestationType   @default(FORMATION)
  
  // Informations personnelles
  fullName       String
  gender         Gender?           // M ou F
  birthDate      DateTime
  birthPlace     String
  
  // Formation associée
  formationId    String
  formation      Formation         @relation(fields: [formationId], references: [id])
  
  // Détails de la formation
  startDate      DateTime
  endDate        DateTime
  location       String
  instructor     String
  issuingCompany String
  
  // Statut
  status         AttestationStatus @default(PENDING)
  
  // Champs spécifiques pour STAGE
  stageHours     Int?              // Nombre d'heures de stage
  stageScore     Float?            // Score du stage (0-100)
  stageObservations String?        // Observations du tuteur
  
  // Champs spécifiques pour CERTIFICATION
  certificationMention CertificationMention?  // Mention obtenue
  certificationScore Float?         // Score de certification (0-100)
  certificationHours Int?           // Heures de formation pour certification
  certificationObservations String? // Observations du jury
  
  // Métadonnées
  pdfUrl         String?
  userId         String?
  user           User?             @relation(fields: [userId], references: [id])
  correctionRequests CorrectionRequest[]
}

model Settings {
  id                  String  @id @default(uuid())
  institutionName     String
  logoUrl             String?
  replyTo             String?
  targetInscriptions  Int     @default(100)
  targetAttestations  Int     @default(50)
  targetValidations   Int     @default(75)
  updatedAt           DateTime @updatedAt
}

model Report {
  id              String   @id @default(uuid())
  codeAttestation String?  // Code de l'attestation signalée (optionnel)
  motif           String   // Motif du signalement
  message         String   // Message détaillée
  email           String?  // Email du déclarant (optionnel)
  createdAt       DateTime @default(now())
  status          String   @default("NOUVEAU") // Statut du traitement
}

model Admin {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String?
  role          String    @default("ADMIN")
  emailVerified DateTime?
  
  // Informations pour les attestations
  birthDate     DateTime?
  birthPlace    String?
  phone         String?
  address       String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Exam {
  id              String          @id @default(uuid())
  name            String
  title           String
  description     String?
  status          ExamStatus      @default(DRAFT)
  duration        Int             @default(3600) // seconds
  passingScore    Int             @default(60) // percentage
  totalPoints     Int             @default(100)
  
  // Configuration des parties
  part1Enabled    Boolean         @default(true)
  part1Questions  Int             @default(20)
  part1Points     Int             @default(20)
  part2Enabled    Boolean         @default(true)
  part2Questions  Int             @default(5)
  part2Points     Int             @default(40)
  part3Enabled    Boolean         @default(true)
  part3Subject    String?         @db.Text
  part3Points     Int             @default(40)
  part3Mode       String          @default("digital") // "digital" or "physical"
  
  // Options
  randomizeQuestions Boolean      @default(false)
  showResults     Boolean         @default(false)
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  formationId     String?
  formation       Formation?      @relation(fields: [formationId], references: [id])
  users           User[]
  parts           ExamPart[]
  sessions        ExamSession[]
  scheduledAt     DateTime?
}

model ExamPart {
  id              String          @id @default(uuid())
  examId          String
  exam            Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  title           String
  type            String          // "QCM", "OPEN", "CASE_STUDY"
  duration        Int             // Minutes
  points          Int             // 20, 40, or 40
  order           Int
  questions       Question[]
  scenario        String?         @db.Text
}

model Question {
  id              String          @id @default(uuid())
  partId          String
  part            ExamPart        @relation(fields: [partId], references: [id], onDelete: Cascade)
  text            String          @db.Text
  type            QuestionType    @default(SINGLE_CHOICE)
  points          Float           @default(1)
  order           Int
  options         QuestionOption[]
}

model QuestionOption {
  id              String          @id @default(uuid())
  questionId      String
  question        Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text            String
  isCorrect       Boolean         @default(false)
}

model ExamSession {
  id              String          @id @default(uuid())
  examId          String
  exam            Exam            @relation(fields: [examId], references: [id])
  userId          String
  candidate       User            @relation(fields: [userId], references: [id])
  status          String          @default("PENDING") // PENDING, GRADED, IN_PROGRESS, COMPLETED
  scorePart1      Float           @default(0)
  scorePart2      Float           @default(0)
  scorePart3      Float           @default(0)
  score           Float           @default(0) // mapping totalScore to score for current_problems compatibility
  totalScore      Float           @default(0)
  gradedBy        String?         // Admin name or ID
  gradedAt        DateTime?
  startedAt       DateTime        @default(now())
  submittedAt     DateTime?       @default(now())
  updatedAt       DateTime        @updatedAt
  answers         Json?           @default("{}")
  scans           CompositionScan[]
}

model CompositionScan {
  id            String    @id @default(uuid())
  submissionId  String
  session       ExamSession @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  url           String
  pageNumber    Int       @default(1)
  fileName      String
  fileSize      Int       // in bytes
  uploadedBy    String    // Admin ID
  uploadedAt    DateTime  @default(now())
}

enum InternshipStatus {
  PENDING
  REVIEWING
  ACCEPTED
  REJECTED
  ARCHIVED
}

model InternshipRequest {
  id              String           @id @default(uuid())
  userId          String?
  user            User?            @relation(fields: [userId], references: [id])
  fullName        String
  email           String
  phone           String
  university      String?
  level           String?          // e.g. "Bac +3"
  position        String           // Desired role
  message         String?          @db.Text
  status          InternshipStatus @default(PENDING)
  cvUrl           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

enum CorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

model CorrectionRequest {
  id             String            @id @default(uuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])

  attestationId  String?
  attestation    Attestation?      @relation(fields: [attestationId], references: [id])

  field          String            // e.g. "fullName", "birthDate", "birthPlace"
  oldValue       String?
  newValue       String
  reason         String?           // Why the change is needed

  status         CorrectionStatus  @default(PENDING)

  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

// Security & Audit Logs (à ajouter pour la traçabilité)
model SecurityLog {
  id        String   @id @default(uuid())
  eventType String
  userId    String?
  ipAddress String?
  userAgent String?
  resource  String?
  resourceId String?
  action    String?
  status    String
  severity  String
  details   Json?
  timestamp DateTime @default(now())

  @@index([eventType])
  @@index([userId])
  @@index([timestamp])
  @@index([severity])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  resource   String
  resourceId String
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([timestamp])
}
